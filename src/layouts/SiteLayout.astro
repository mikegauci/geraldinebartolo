---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { page, header, footer } = Astro.props;
---
<!DOCTYPE html>
<html lang="en-US">
  <head>
    <Fragment set:html={page.head} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <body class={page.bodyClass} itemscope itemtype="https://schema.org/WebPage">
    <a class="skip-link screen-reader-text" href="#content">Skip to content</a>
    <div class="hfeed site" id="page">
      <Header html={header} />
      <slot />
      <Footer html={footer} />
    </div>
    <script is:inline define:vars={{astra: page.astra}}>
      window.astra = astra;
    </script>
    <script is:inline src={page.themeScript}></script>
  </body>
</html>
